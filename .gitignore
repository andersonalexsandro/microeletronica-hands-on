# ============================================================
# .gitignore - o que o Git NAO guarda
# Regra do projeto: o repositorio guarda fontes, scripts e
# relatorios; tudo que uma ferramenta gera e refeito com make.
# ============================================================

# Tudo que as ferramentas geram vai para build/ (ver Makefile)
build/

# ------------------------------------------------------------
# Restos caso alguma ferramenta seja rodada fora do Makefile
# ------------------------------------------------------------
# Synopsys vlogan e VCS (compilacao e simulacao)
csrc/
simv
simv.daidir/
*.daidir/
AN.DB/
work.lib++/
64/
ucli.key
vc_hdrs.h
.vlogan*
# Synopsys Verdi e DVE (visualizacao de ondas e debug)
novas*
verdi*/
DVEfiles/
# Formas de onda: fsdb (Verdi), vpd (DVE), vcd (GTKWave)
*.fsdb
*.vpd
*.vcd
# Icarus Verilog (programa compilado) e Verilator (pasta de trabalho)
*.vvp
obj_dir/
# Design Compiler (sintese, semanas 8 e 13)
command.log
default.svf
alib-*/
# Formality (equivalencia formal, semanas 9, 10 e 13)
FM_WORK/
fm_shell_command.log
formality_svf.txt
# Python (cache do modelo de referencia)
__pycache__/

# ============================================================
# Bibliotecas / PDK (licenciadas - NUNCA versionar)
# ============================================================
libs/
*.db
*.sldb
